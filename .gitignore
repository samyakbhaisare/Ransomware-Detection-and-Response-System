# Runtime state — never commit live data
data/*.db
data/*.db-*
data/**/*.db
data/**/*.db-*
logs/
*.log

# Configuration backups (the canonical config.yaml is tracked)
config.yaml.bak-*
config.yaml.damaged-*
config.yaml.pre-*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / coverage artefacts
.coverage
.coverage.*
coverage.json
cov_raw.json
htmlcov/
.pytest_cache/
.pytest-tmp/

# Local verification scratch space: harnesses, CDP drivers, screenshots,
# junit XML and rendered compose output. Reproducible, not source.
ptmp/

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Local agent workspace data
.workbuddy-ai/

# Audit run output — regenerated by the audit scripts
*_AUDIT_*.txt
*_AUDIT_*.json
*_audit_*.txt
AUDIT_SUMMARY.txt
COMPLETE_FR_PHASE_AUDIT.txt
FINAL_TEST_RESULT.txt
RDRS_ALL_AUDITS_*.txt
RDRS_COVERAGE.json
RDRS_FULL_SOURCE_AUDIT.zip
audit_pytest_run.txt
*.broken-backup

# Generated reports and quarantine evidence are runtime output
reports/backups/
data/reports/
data/quarantine/
e2e_out/
