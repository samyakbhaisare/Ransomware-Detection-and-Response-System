# Runtime state — never commit live data
data/*.db
data/*.db-*
data/**/*.db
data/**/*.db-*
data/sandbox/
data/probe_root.txt
logs/
*.log

# Local environment secrets; the empty example manifest is safe to distribute.
.env
.env.*
!.env.example

# Configuration backups (the canonical config.yaml is tracked)
config.yaml.bak-*
config.yaml.damaged-*
config.yaml.pre-*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtual environments
.venv/
venv/
env/

# Test / coverage artefacts
.coverage
.coverage.*
coverage.json
cov_raw.json
htmlcov/
.pytest_cache/
.pytest-tmp/

# Local verification scratch space: harnesses, CDP drivers, screenshots,
