# Generated reports and quarantine evidence are runtime output
reports/backups/
data/reports/
data/quarantine/
e2e_out/

# Curated, sanitized submission excerpts are deliberate evidence, not runtime logs.
!submission/evidence/logs/
!submission/evidence/logs/**

# Server-only ACME account/certificate secrets must never enter the repository.
