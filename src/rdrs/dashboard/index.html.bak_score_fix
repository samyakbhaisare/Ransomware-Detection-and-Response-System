        stopBtn.disabled = !running;
    }

    function renderStatus(data) {
        state.status = data;

        const runtimeState =
            data && data.state
                ? data.state
                : "UNKNOWN";

        updateControls(runtimeState);

        if (runtimeState === "RUNNING") {
            statusDot.style.background =
                "var(--green)";

            statusText.textContent =
                "RDRS monitoring RUNNING";
            return;
        }

        if (runtimeState === "DEGRADED") {
            statusDot.style.background =
                "var(--yellow)";

            statusText.textContent =
                "RDRS monitoring DEGRADED";
            return;
        }

        if (runtimeState === "STARTING") {
            statusDot.style.background =
                "var(--yellow)";

            statusText.textContent =
                "RDRS monitoring STARTING";
            return;
        }

        if (runtimeState === "FAILED") {
            statusDot.style.background =
                "var(--red)";

            statusText.textContent =
                "RDRS runtime FAILED";
            return;
        }

        if (runtimeState === "SHUTTING_DOWN") {
            statusDot.style.background =
                "var(--yellow)";

            statusText.textContent =
                "RDRS monitoring SHUTTING DOWN";
            return;
        }

        statusDot.style.background =
            "var(--muted-2)";

        statusText.textContent =
            "RDRS monitoring STOPPED";
    }

