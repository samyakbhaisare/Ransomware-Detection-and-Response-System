    function normalizeSeries(
        source,
        valueKeys
    ) {
        if (!Array.isArray(source)) {
            return [];
        }

        return source.map(item => {
            if (
                typeof item === "number"
            ) {
                return item;
            }

            for (const key of valueKeys) {
                const value =
                    Number(item?.[key]);

                if (Number.isFinite(value)) {
                    return value;
                }
            }

            return null;
        }).filter(
            value => value !== null
        );
    }

    function drawChart(
        canvas,
        values,
        minValue,
        maxValue
    ) {
        const context =
            canvas.getContext("2d");

        const width =
            canvas.clientWidth || 500;

        const height =
            canvas.clientHeight || 250;

        const ratio =
            window.devicePixelRatio || 1;

        canvas.width =
            width * ratio;

        canvas.height =
            height * ratio;

        context.setTransform(
            ratio,
            0,
            0,
            ratio,
            0,
            0
        );

        context.clearRect(
            0,
            0,
            width,
            height
        );

        context.strokeStyle =
            "#26313d";

        context.lineWidth = 1;

        for (let i = 1; i < 5; i++) {
            const y =
                (height / 5) * i;

            context.beginPath();
            context.moveTo(0, y);
            context.lineTo(width, y);
            context.stroke();
        }

        if (!values.length) {
            context.fillStyle =
                "#687584";

            context.font =
                "12px Arial";

            context.textAlign =
                "center";

            context.fillText(
                "No telemetry data",
                width / 2,
                height / 2
            );

            return;
        }

        const range =
            Math.max(
                maxValue - minValue,
                0.0001
            );

        const padding = 15;

        context.strokeStyle =
            "#79c0ff";

        context.lineWidth = 2;

        context.beginPath();

        values.forEach(
            (value, index) => {
                const x =
                    values.length === 1
                        ? width / 2
                        : padding +
                          (
                              (width -
                               padding * 2) /
                              (values.length - 1)
                          ) * index;

                const normalized =
                    (
                        value - minValue
                    ) / range;

                const y =
                    height -
                    padding -
                    normalized *
                    (height - padding * 2);

                if (index === 0) {
                    context.moveTo(x, y);
                } else {
                    context.lineTo(x, y);
                }
            }
        );

        context.stroke();

        context.fillStyle =
            "#79c0ff";

        values.forEach(
            (value, index) => {
                const x =
                    values.length === 1
                        ? width / 2
                        : padding +
                          (
                              (width -
                               padding * 2) /
                              (values.length - 1)
                          ) * index;

                const normalized =
                    (
                        value - minValue
                    ) / range;

                const y =
                    height -
                    padding -
                    normalized *
                    (height - padding * 2);

                context.beginPath();
                context.arc(
                    x,
                    y,
                    2.5,
                    0,
                    Math.PI * 2
                );
                context.fill();
            }
        );
    }

    function renderCharts(data) {
        const telemetry =
            data?.telemetry || {};

        const cpu =
            normalizeSeries(
                data?.cpu_history ||
                telemetry.cpu_history ||
                telemetry.cpu ||
                [],
                [
                    "cpu_percent",
                    "cpu",
                    "value"
                ]
            );

        const entropy =
            normalizeSeries(
                data?.entropy_history ||
                telemetry.entropy_history ||
                telemetry.entropy ||
                [],
                [
                    "entropy",
                    "value"
                ]
            );

        drawChart(
            document.getElementById("cpuChart"),
            cpu,
            0,
            100
        );

        drawChart(
            document.getElementById(
                "entropyChart"
            ),
            entropy,
            0,
            8
        );
    }

