    async function generateReport(
        incidentId,
        format
    ) {
        showMessage(
            `Generating ${format.toUpperCase()} report...`
        );

        const params =
            new URLSearchParams({
                incident_id: incidentId,
                format: format
            });

        const result =
            await request(
                `${API.reportGenerate}?${params}`,
                {
                    method: "POST",
                    headers: {
                        "Accept":
                            "application/json"
                    }
                }
            );

        showMessage(
            `${format.toUpperCase()} report generated for incident #${incidentId}.`
        );

        const path =
            result.path;

        if (!path) {
            return;
        }

        const filename =
            path.split(/[\\/]/).pop();

        const downloadUrl =
            `${API.reports}/${incidentId}/${format}`;

        const link =
            document.createElement("a");

        link.href = downloadUrl;
        link.download = filename || "";
        document.body.appendChild(link);
        link.click();
        link.remove();
    }

