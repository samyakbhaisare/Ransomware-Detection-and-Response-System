    async function saveSettings(event) {
        event.preventDefault();

        const form =
            new FormData(event.target);

        const payload = {
            name:
                String(
                    form.get("name") || ""
                ).trim(),

            environment:
                String(
                    form.get("environment") || ""
                ).trim(),

            shutdown_timeout:
                Number(
                    form.get(
                        "shutdown_timeout"
                    )
                ),

            log_level:
                String(
                    form.get("log_level") || "INFO"
                ),

            persistence_enabled:
                form.get(
                    "persistence_enabled"
                ) === "true"
        };

        if (!payload.name) {
            throw new Error(
                "Runtime name cannot be empty."
            );
        }

        if (!payload.environment) {
            throw new Error(
                "Environment cannot be empty."
            );
        }

        if (
            !Number.isFinite(
                payload.shutdown_timeout
            ) ||
            payload.shutdown_timeout <= 0
        ) {
            throw new Error(
                "Shutdown timeout must be positive."
            );
        }

        await request(
            API.settings,
            {
                method: "POST",
                headers: {
                    "Content-Type":
                        "application/json",
                    "Accept":
                        "application/json"
                },
                body: JSON.stringify(payload)
            }
        );

        showMessage(
            "Runtime settings saved."
        );
    }

    async function refreshCurrentPage(
        page
    ) {
        if (page === "dashboard") {
            await loadDashboard();
            return;
        }

        if (page === "events") {
            await loadEventsPage();
            return;
        }

        if (page === "processes") {
            await loadProcessesPage();
            return;
        }

        if (page === "alerts") {
            await loadAlertsPage();
            return;
        }

        if (page === "incidents") {
            await loadIncidentsPage();
            return;
        }

        if (page === "reports") {
            await loadReportsPage();
            return;
        }

        if (page === "settings") {
            await loadSettings();
        }
    }

    async function navigate(page) {
        document
            .querySelectorAll(".nav-item")
            .forEach(item => {
                item.classList.toggle(
                    "active",
                    item.dataset.page === page
                );
            });

        document
            .querySelectorAll(".page")
            .forEach(section => {
                section.classList.toggle(
                    "active",
                    section.id ===
                    `page-${page}`
                );
            });

        const title =
            pageTitles[page] ||
            pageTitles.dashboard;

        document.getElementById(
            "pageTitle"
        ).textContent = title[0];

        document.getElementById(
            "pageSubtitle"
        ).textContent = title[1];

        try {
            showMessage("");
            await refreshCurrentPage(page);
        } catch (error) {
            console.error(error);
            showMessage(error.message);
        }
    }

    async function refreshAll() {
        try {
            showMessage("");

            const status =
                await request(API.status);

            renderStatus(status);

            const active =
                document.querySelector(
                    ".nav-item.active"
                );

            const page =
                active?.dataset.page ||
                "dashboard";

            await refreshCurrentPage(page);

        } catch (error) {
            console.error(error);

            statusDot.style.background =
                "var(--red)";

            statusText.textContent =
                "RDRS API unavailable";

            showMessage(
                error.message
            );
        }
    }

    async function controlRuntime(
        endpoint,
        successMessage
    ) {
        startBtn.disabled = true;
        stopBtn.disabled = true;

        try {
            const data =
                await request(
                    endpoint,
                    {
                        method: "POST",
                        headers: {
                            "Accept":
                                "application/json"
                        }
