            }
        );

    document
        .getElementById("loadSettingsBtn")
        .addEventListener(
            "click",
            async () => {
                try {
                    await loadSettings();
                } catch (error) {
                    console.error(error);
                    showMessage(
                        error.message
                    );
                }
            }
        );

    window.addEventListener(
        "resize",
        () => {
            if (state.dashboard) {
                renderCharts(
                    state.dashboard
                );
            }
        }
    );

    updateControls("STOPPED");

    refreshAll();

    setInterval(
        refreshAll,
        5000
    );
</script>

</body>
</html>